config AUDIO_COGNITION
	bool "notify audio cognition data to user"
	default n

config AUDIO_BLOW_COGNITION
	bool "support audio blow cognition driver"
	depends on AUDIO_COGNITION
	default n
	help
		support audio blow cognition driver

