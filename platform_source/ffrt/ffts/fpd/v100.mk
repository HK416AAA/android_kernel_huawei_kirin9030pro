FFTS_ARCH_VERSION=ffts_v100
export FFTS_ARCH_VERSION

FFTS_FILE_OBJECTS += $(FFTS_ARCH_VERSION)/ffts_hw_config.o
FFTS_FILE_OBJECTS += $(FFTS_ARCH_VERSION)/ffts_intr_config.o

ifeq ($(CONFIG_FFRT_DEBUG),y)
FFTS_GLOBAL_CFLAGS += -DCONFIG_FFRT_DEBUG
FFTS_FILE_OBJECTS += $(FFTS_ARCH_VERSION)/ffts_perf_config.o
endif

FFTS_FILE_OBJECTS += $(FFTS_ARCH_VERSION)/ffts_resmem.o

ifeq ($(CONFIG_FFTS_NOT_SEND_EVENT_TO_RTB),y)
FFTS_GLOBAL_CFLAGS += -DFFTS_NOT_SEND_EVENT_TO_RTB
endif
