config FRAME_VIP_SCHED_OPT
	bool "Implement select_task_rq for frame hwvip tasks"
	default n
	help
	  Before, hwvip tasks use the same select_task_rq like normal cfs
	  tasks. But it should use rt select_task_rq. So we implement a
	  single find_hwvip_cpu(), which is the same thing as rt_energy_
	  aware_wake_cpu() (Note that there's no need to combine the two
	  functions as one. All find cpu logic should have its own function
	  based on find_best_candidate()).
	  And since static/dynamic hwvip is much more than frame vip (the
	  vip uclamp cgroup), we only do this for frame vips which is helpful
	  for performance.

config FRAME_VIP_FULL_WINDOW_BOOST
	bool "Boost frame vip task's util when it runs full walt window"
	default n
	help
	  Originally we did it for hwvip tasks who have WALT_PREDICT_VIP_BOOST
	  in walt predl as a part of the logic of predicting sudden load.
	  This feature is weaker in performance, but better for energy.

config FRAME_VIP_IO_IS_BUSY
	bool "Account iowait as busy for frame vip tasks"
	default n

config WALT_HYBRID_WINDOW
	bool "Introduce FREQ_STAT_VIP_ACC_TASK for frame_vip tasks in schedutil"
	depends on SCHED_PRED_LOAD
	select FRAME_WINDOW
	default n
	help
	  This feature default enables predl_enable and FREQ_STAT_VIP_ACC_TASK
	  and predl_window_size_sync_with_frame (and also make predl_enable
	  not allowed to turn off). So in simple terms it add an independent
	  signal to schedutil that tracks frame_vip tasks's load in frame
	  window size, and this signal supports FRAME_VIP_FULL_WINDOW_BOOST
	  and FRAME_VIP_IO_IS_BUSY.
	  With predl_enable, all kinds of predict load are calculated.
	  With FREQ_STAT_VIP_ACC_TASK, schedutil takes predl_max_vip_util(rq)
	  into consideration, which is the max of predl_vip_accelerated_task.
	  And with FREQ_STAT_VIP_ACC_TASK, scheduler takes task_pred_util(p)
	  of predl_vip_accelerated_task into consideration.
	  And predl_vip_accelerated_task is is_frame_vip(p) or specifically
	  marked task (static vip WALT_PREDICT_VIP_BOOST_STATE).
	  With predl_window_size_sync_frame, predl_window_size follows frame
	  window size and nobody should write predl_window_size. If someone
	  need to change predl_window_size, remember to turn the sync_frame off.

config SCHED_UNI_TASK_ATTR_CONFIG_INTERFACE
	bool "Unified iterfaces for setting any property of speficied tasks"
	depends on HISI_EAS_SCHED
	default n
	help
	  When you need something like a whitelist of tasks, this is it.
	  We introduce sysfs interfaces like set_task_prop_by_thread_name /
	  set_task_prop_by_process_name / set_task_prop_by_uid /
	  set_task_prop_by_<whatever> in /sys/kernel/eas/.
	  Format: <property> <value_for_the_property> <list of names/uids/..>
	  (separated by spaces).
	  In detail we apply changes in the ttwu hook, so the whitelists
	  are checked at each wakeup of each task.

config MICROVISOR_DYNAMIC_SHARED_CPU
	bool "Support computing power sharing between RDA and noRDA"
	default n
	help
	  if set, kernel will identify the shared core of RDA.

config SCHED_CHIP_INFO
	bool "Support sched chip info"
	default n

config SCHED_THERMAL_REPORT
	bool "Support sched thermal report"
	default n

config INDEPENDENT_FAIR_SLEEPER_BONUS
	bool "An independent config of vruntime bonus for cfs place_entity"
	default n
	help
	  1. Export the fair sleeper bonus as an important config similar to
	  sched_wakeup_granularity_ns/sched_min_granularity_ns.
	  2. Default set it as a reasonable value, correct the upstream's
	  default behavior on our platform.
	  In general, we don't want too much meaningless wakeup preemption.
	  The upstream design is good for Linux server but very bad for
	  mobile devices, which is a very different user interactive pattern
	  and performance requirement.
	  This feature makes things right (reduce meaningless wakeup
	  preemption and improves ipc/throughput), but still must use with
	  care since it affects too much.

config CPUIDLE_STATE_NOTIFY
	bool "Notify which C-state CPU entered"
	default n
	help
	  Register the notifier to monitor the C-sate of CPU if interested.

