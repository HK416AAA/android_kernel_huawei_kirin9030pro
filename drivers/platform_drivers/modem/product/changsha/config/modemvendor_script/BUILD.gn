import("//build/ohos.gni")
import("//vendor/hisi/ap/build/build_args.gni")
import("//vendor/hisi/modem/build/build_args.gni")

action("file_copy") {
  deps = [
      "//vendor/hisi/modem/app/rfile_user:rfile_user_phone",
      "//vendor/hisi/modem/product/$device_name/config/modem_ps_user_script:modem_ps_user_build",
      "//vendor/hisi/modem/product/$device_name/config/tool_config_script:tool_config_build",
    ]
  if (modem_build_variant != "user") {
    deps += [
        "//vendor/hisi/modem/app/logdeflatsvr:mdmlogdeflatsvr",
        "//vendor/hisi/modem/app/heating_proxy:heating_proxy",
        "//vendor/hisi/modem/app/modem_manufacture:modem_aging",
        "//vendor/hisi/modem/app/modem_aging_test:modem_aging_test",
        "//vendor/hisi/modem/ap/phone/build/ohos/modem_vendor_build/mtp_build_user/harmony:mtp_acore_user",
        "//vendor/hisi/modem/ap/phone/build/ohos/modem_vendor_build/mtp_build_user_public/harmony:mtp_acore_user_public",
        "//vendor/hisi/modem/app/st_test:st_app_test",
      ]
  } else if (modem_build_with_log) {
    deps += [
        "//vendor/hisi/modem/app/logdeflatsvr:mdmlogdeflatsvr"
      ]
  }
    script = "//vendor/hisi/modem/product/$device_name/config/modemvendor_script/copy.sh"
    product_out = rebase_path(root_build_dir, "//")
    args = [
      "OBB_PRODUCT_NAME=$device_name",
      "PRODUCT_OUT=$product_out",
      "BUILD_VARIANT=$modem_build_variant",
      "modem_build_with_log=$modem_build_with_log"
    ]
  outputs = ["$target_gen_dir/modem_vendor_build.log"]
}

group("modem_vendor_device") {
  deps = [
    ":file_copy",
  ]
}
