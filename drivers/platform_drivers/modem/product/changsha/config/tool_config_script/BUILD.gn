import("//build/ohos.gni")
import("//vendor/hisi/ap/build/build_args.gni")
import("//vendor/hisi/modem/build/build_args.gni")
import("//vendor/hisi/modem/ap/phone/build/ohos/script/build_args.gni")

build_out = rebase_path(root_build_dir, "//")

action("tool_config_build") {
  deps = [
    "//vendor/hisi/modem/ap/phone/build/ohos/prebuilts/tool_config:log_default",
    "//vendor/hisi/modem/ap/phone/build/ohos/prebuilts/tool_config:log_mid",
    "//vendor/hisi/modem/ap/phone/build/ohos/prebuilts/tool_config:log_mini",
    "//vendor/hisi/modem/ap/phone/build/ohos/prebuilts/tool_config:chr_msg",
    "//vendor/hisi/modem/ap/phone/build/ohos/prebuilts/tool_config:chr_msg_group",
  ]

  script = "//vendor/hisi/modem/product/changsha/config/tool_config_script/tool_copy.sh"
  args = [
    "PRODUCT_NAME=$device_name",
    "BUILD_OUT=$build_out",
  ]

  outputs = ["$target_gen_dir/tool_config_build.log"]
}
