shared_unsec_mem{
    compatible = "shared_unsec_mem";
    addr = <0x1EE00000>;
    size = <0xC0000>;
    dts_info_size = <0x1000>;
    usshm_pin{
        mem-names = "usshm_pinctrl";
        size = <0x1800>;
    };
    usshm_product{
        mem-names = "usshm_product";
        size = <0x800>;
    };
    usshm_msg_mid{
        mem-names = "usshm_msg_mid";
        size = <0x4000>;
    };
    usshm_nv{
        mem-names = "usshm_nv";
        size = <0x400>;
    };
    usshm_diag{
        mem-names = "usshm_diag";
        size = <0x4>;
    };
    usshm_reset{
        mem-names = "usshm_reset";
        size = <0x400>;
    };
    usshm_dpa_cma{
        mem-names = "usshm_dpa_cma";
        size = <0x40>;
    };
    usshm_dpa_profile{
        mem-names = "usshm_dpa_profile";
        size = <0x4>;
    };
    usshm_dpa_dra{
        mem-names = "usshm_dpa_dra";
        size = <0x8>;
    };
    usshm_dpa_mo_size{
        mem-names = "usshm_dpa_mo_size";
        size = <0x4>;
    };
    usshm_dpa_ate{
        mem-names = "usshm_dpa_ate";
        size = <0x4>;
    };
    usshm_test{
        mem-names = "usshm_test";
        size = <0x300>;
    };
    usshm_test1{
        mem-names = "usshm_test1";
        size = <0x200>;
    };
};
shared_nsro{
    compatible = "shared_nsro_mem";
    addr = <0x1E001000>;
