shared_sec_mem{
    compatible = "shared_sec_mem";
    addr = <0xABC80000>;
    size = <0x80000>;
    dts_info_size = <0x1000>;
    /* 安全os无法申请DMA内存，所以使用共享内存，这块内存有对齐要求 */
    seshm_secos_fipcptr{
        mem-names = "seshm_secos_fipcptr";
        size = <0x800>;
    };
    /* 安全os无法申请DMA内存，所以使用共享内存，这块内存有对齐要求 */
    seshm_secos_msgdma{
        mem-names = "seshm_secos_msgdma";
        size = <0x2800>;
    };
    /* mtee eicc通道的ringbuf和推送地址,起始地址8字节对齐 */
    seshm_ficc_dma{
        mem-names = "seshm_ficc_dma";
        size = <0x208>;
    };
    seshm_test{
        mem-names = "seshm_test";
        size = <0x300>;
    };
    seshm_test1{
        mem-names = "seshm_test1";
        size = <0x200>;
    };
};
