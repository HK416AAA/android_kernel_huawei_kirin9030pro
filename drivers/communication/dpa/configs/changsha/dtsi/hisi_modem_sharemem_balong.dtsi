    };
    nsroshm_dump{
        mem-names = "nsroshm_dump";
        size = <0x30>;
    };
    nsroshm_lpmcu_para{
        mem-names = "nsroshm_lpmcu_para";
        size = <0x2000>;
    };
    nsroshm_avs_trim{
        mem-names = "nsroshm_avs_trim";
        size = <0x300>;
